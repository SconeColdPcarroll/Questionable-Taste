{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/apps/web/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/apps/web/index.html"
    }
  ],
  "installCommand": "npm install --workspaces=false --include=dev",
  "buildCommand": "echo \"No build step required\""
}
